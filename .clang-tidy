---
Checks: '
  bugprone-*,
  -bugprone-suspicious-stringview-data-usage,
  -bugprone-reserved-identifier,
  performance-*,
  -performance-no-int-to-ptr,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.NewDelete*,
  clang-analyzer-deadcode.*,
  clang-analyzer-nullability.*,
  
  modernize-deprecated-headers,
  modernize-make-unique,
  modernize-make-shared,
  modernize-pass-by-value,
  modernize-replace-auto-ptr,
  modernize-use-auto,
  modernize-use-emplace,
  modernize-use-nullptr,
  modernize-use-override,
  readability-isolate-declaration,
  misc-unused-using-decls,
  misc-anonymous-namespace-in-header,
  -misc-include-cleaner,
  misc-header-include-cycle,
  misc-misplaced-const,
  misc-definitions-in-headers,
  misc-redundant-expression,
  readability-*,
  -readability-identifier-length,
  -readability-convert-member-functions-to-static,
  -readability-magic-numbers,
  -readability-avoid-unconditional-preprocessor-if,
  -readability-implicit-bool-conversion,
  -readability-function-cognitive-complexity,
  -readability-else-after-return,
  -readability-uppercase-literal-suffix,
  -readability-named-parameter,
  -readability-math-missing-parentheses,
  -readability-suspicious-call-argument,
  -readability-use-concise-preprocessor-directives,
  -readability-use-anyofallof,
  -readability-simplify-boolean-expr,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-unix.BlockInCriticalSection,
  -bugprone-exception-escape,
  -clang-analyzer-optin.cplusplus.UninitializedObject
'

HeaderFilterRegex: '^(?!.*(usr/|fmt/|boost_|unordered_dense/)).*$'

CheckOptions:
  performance-unnecessary-copy-initialization.AllowedTypes: 'std::shared_ptr;std::unique_ptr'
  modernize-use-nullptr.NullMacros: 'NULL'
  modernize-use-auto.MinTypeNameLength: 5
  misc-include-cleaner.MissingIncludes: false

WarningsAsErrors: ''
